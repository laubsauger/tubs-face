# ==========================================
# 1. CORE PIPELINE & LLM ROUTING
# ==========================================
# PROCESSING_MODE determines the main backend architecture:
# - legacy: purely Node.js based routing
# - realtime: dedicated Python STT/TTS service on port 3002
PROCESSING_MODE=realtime

# LLM_PROVIDER defines the primary conversational engine:
# - gemini: Uses the native Node.js Gemini SDK (recommended)
# - realtime: Uses Python backend to proxy Ollama or OpenAI
LLM_PROVIDER=gemini


# ==========================================
# 2. GEMINI CONFIGURATION (When LLM_PROVIDER=gemini)
# ==========================================
# Gemini API key (required for conversational replies)
GEMINI_API_KEY=your_gemini_api_key_here

# Any supported Gemini model name for generateContent.
# Examples: gemini-3-flash-preview, gemini-2.5-flash
GEMINI_MODEL=gemini-3-flash-preview

# Keep this low for conservative token usage.
GEMINI_MAX_OUTPUT_TOKENS=256


# ==========================================
# 3. REALTIME PYTHON BACKEND (STT & TTS)
# ==========================================
REALTIME_PROCESSING_PORT=3002
REALTIME_STT_BACKEND=mlx
REALTIME_STT_MODEL=small

REALTIME_TTS_BACKEND=kokoro
REALTIME_KOKORO_VOICE=hm_omega
TTS_STREAMING_ENABLED=true


# ------------------------------------------
# 3.1 REALTIME LLM PROXY (Only if LLM_PROVIDER=realtime)
#     If LLM_PROVIDER is gemini, these settings are ignored.
# ------------------------------------------
REALTIME_LLM_PROVIDER=ollama
REALTIME_LLM_MODEL=

# Standard Ollama configuration
OLLAMA_HOST=127.0.0.1:11434

# Standard OpenAI configuration
REALTIME_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=


# ==========================================
# 4. DUAL HEAD (Multi-Agent Scripts)
# ==========================================
# The dual-head feature lets a secondary persona talk. It defaults to the 
# main LLM model, but you can override the specific model and temperature here.
DUAL_HEAD_LLM_MODEL=gemini-3-flash-preview
DUAL_HEAD_TEMPERATURE=1


# ==========================================
# 5. OBSERVABILITY (LANGFUSE)
# ==========================================
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"


# ==========================================
# 6. MEMORY & CONTEXT TUNING
# ==========================================
ASSISTANT_HISTORY_TTL_MS=240000
ASSISTANT_MEMORY_TTL_MS=360000
PRESENCE_CONTEXT_CLEAR_DELAY_MS=60000
PRESENCE_CONTEXT_CLEAR_COOLDOWN_MS=15000

# Cost estimation (USD per 1k tokens, 0 disables it)
GEMINI_INPUT_COST_PER_MTOKENS=0.1
GEMINI_OUTPUT_COST_PER_MTOKENS=0.5


# ==========================================
# 7. DONATIONS & PAYWALL
# ==========================================
DONATION_VENMO=TubsBot
DONATION_QR_DATA=https://venmo.com/u/TubsBot
DONATION_SIGNAL_MODE=both
DONATION_WEBHOOK_TOKEN=

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_DEFAULT_DONATION_AMOUNT=5.00


# ==========================================
# 8. MISCELLANEOUS (Legacy / Advanced)
# ==========================================
WHISPER_MODEL=small
MIN_FACE_BOX_AREA_RATIO=0.02

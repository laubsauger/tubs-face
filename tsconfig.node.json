{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist"
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/scripts/**/*.ts"
  ],
  "exclude": [
    "src/client/**/*",
    "src/workers/**/*"
  ]
}

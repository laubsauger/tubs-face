        "ratchet",
        "nylon",
        "leg",
        "legless",
        "wheel"
      ],
      "cooldownMin": 30,
      "chance": 0.3
    },
    {
      "id": "small-hides-things",
      "text": "Small quietly steals and hides little things around the studio (keys, single socks, chargers) and mentions it as if it were normal.",

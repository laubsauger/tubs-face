# ==========================================
# 1. CORE PIPELINE & LLM ROUTING
# ==========================================
# Speech runs in the Python service (src/realtime-processing-service.py, port 3002):
# Kokoro or system TTS, MLX or faster-whisper STT. The server starts it.

# LLM_PROVIDER defines the conversational engine (replies are streamed either way):
# - gemini: Gemini from Node (recommended)
# - ollama: a local or remote Ollama, or an OpenAI-compatible server, via the
#   Python service (see REALTIME_LLM_* below). "realtime" is accepted too.
LLM_PROVIDER=gemini


# ==========================================
# 2. GEMINI CONFIGURATION (When LLM_PROVIDER=gemini)
# ==========================================
# Gemini API key (required for conversational replies)
GEMINI_API_KEY=your_gemini_api_key_here

# Any supported Gemini model name for generateContent.
# Examples: gemini-3-flash-preview, gemini-2.5-flash
GEMINI_MODEL=gemini-3-flash-preview

# Keep this low for conservative token usage.
GEMINI_MAX_OUTPUT_TOKENS=256


# ==========================================
# 3. REALTIME PYTHON BACKEND (STT & TTS)
# ==========================================
REALTIME_PROCESSING_PORT=3002
REALTIME_STT_BACKEND=mlx
REALTIME_STT_MODEL=small

REALTIME_TTS_BACKEND=kokoro
REALTIME_KOKORO_VOICE=hm_omega
TTS_STREAMING_ENABLED=true


# ------------------------------------------
# 3.1 LOCAL / REMOTE LLM (Only if LLM_PROVIDER=ollama)
#     If LLM_PROVIDER is gemini, these settings are ignored.
# ------------------------------------------
REALTIME_LLM_PROVIDER=ollama
REALTIME_LLM_MODEL=

# Standard Ollama configuration
OLLAMA_HOST=127.0.0.1:11434

# Standard OpenAI configuration
REALTIME_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=


# ==========================================
# 4. DUAL HEAD (Multi-Agent Scripts)
# ==========================================
# The dual-head feature lets a secondary persona talk. It defaults to the 
# main LLM model, but you can override the specific model and temperature here.
DUAL_HEAD_LLM_MODEL=gemini-3-flash-preview
DUAL_HEAD_TEMPERATURE=1


# ==========================================
# 5. OBSERVABILITY (LANGFUSE)
# ==========================================
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"


# ==========================================
# 6. MEMORY & CONTEXT TUNING
# ==========================================
ASSISTANT_HISTORY_TTL_MS=240000
ASSISTANT_MEMORY_TTL_MS=360000
PRESENCE_CONTEXT_CLEAR_DELAY_MS=60000
PRESENCE_CONTEXT_CLEAR_COOLDOWN_MS=15000

# Cost estimation (USD per 1k tokens, 0 disables it)
GEMINI_INPUT_COST_PER_MTOKENS=0.1
GEMINI_OUTPUT_COST_PER_MTOKENS=0.5


# ==========================================
# 7. STUDIO MODE (sentient-studio contract §5-6)
# ==========================================
# Off by default; also switchable at runtime with POST /studio {"enabled": true}.
# TUBS_STUDIO=1
# TUBS_STUDIO_SITE=http://127.0.0.1:8889
# local | local:<Chrome device label> | site:<path> | off
# TUBS_MIC_SOURCE=local
# chrome: the server opens and closes the face pages; external: something else does
# TUBS_STUDIO_LAUNCH=chrome
# Where the pictures for vision come from in studio mode:
# local | local:<Chrome device label> | snapshot:<url> | site:<path> | off
# TUBS_VISION_SOURCE=off


# ==========================================
# 8. VISION (docs/vision.md; all but the key also live via POST /config)
# ==========================================
# off: no picture leaves the server | gemini: the chat model, or VISION_MODEL | openai: any OpenAI-compatible server
# VISION_PROVIDER=gemini
# VISION_MODEL=
# A base URL ending in /v1 (Ollama: http://<host>:11434/v1), or fleet:vision (picked by the studio-manager hub)
# VISION_BASE_URL=
# VISION_API_KEY=
# FLEET_HUB=http://127.0.0.1:4310
# VISION_MAX_PX=512
# VISION_TIMEOUT_MS=8000
# VISION_REFRESH_MS=30000
# VISION_MAX_PER_HOUR=120
# VISION_WHILE_ASLEEP=false
# Cost estimate for openai (USD per million tokens; 0 for your own GPUs)
# VISION_INPUT_COST_PER_MTOKENS=0
# VISION_OUTPUT_COST_PER_MTOKENS=0


# ==========================================
# 9. RELATIONSHIPS (config/relationships.json, in git)
# ==========================================
# How Tubs treats people he recognises while they are in view; also live via POST /config {"relationshipsEnabled"}
# RELATIONSHIPS_ENABLED=true
# Folder for the shareable config files (relationships.json, presets/<name>.json); default ./config
# TUBS_CONFIG_DIR=

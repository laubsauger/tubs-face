{
  "name": "tubs-bot",
  "version": "1.0.0",
  "description": "Tubs Bot — Animated Chatbot Face Interface",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "postinstall": "node scripts/setup-python.js",
    "start": "node dist/server/index.js",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --force --host",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "setup-python": "node scripts/setup-python.js",
    "bench:llm": "tsx src/scripts/benchmark-llm.ts"
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "fs-extra": "^11.3.3",
    "langfuse": "^3.38.6",
    "onnxruntime-web": "^1.24.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.16.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}